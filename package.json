{
	"name": "base-stack",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"format": "biome format --write .",
		"check_unsafe": "biome check --write --unsafe .",
		"check": "biome check --write .",
		"prepare": "command -v git >/dev/null 2>&1 && lefthook install || echo 'Skipping lefthook (git not found)'",
		"preinstall": "npx only-allow pnpm"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@workspace/typescript-config": "workspace:*",
		"lefthook": "^1.11.8",
		"tsx": "^4.20.6",
		"turbo": "^2.9.14",
		"typescript": "^5.9.2"
	},
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"zod": "^4.3.5"
	}
}
