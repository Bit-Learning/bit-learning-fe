{
	"extends": "@workspace/typescript-config/react-library.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"noEmit": true,
		"jsx": "react-jsx",
		"noUnusedLocals": true,
		"baseUrl": ".",
