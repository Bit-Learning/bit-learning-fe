# ============================
# 1️⃣ BUILD STAGE
# ============================
FROM node:24-alpine AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Copy workspace configuration from monorepo root
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files to establish workspace structure
COPY apps/admin/package.json ./apps/admin/
COPY packages/lib/package.json ./packages/lib/
COPY packages/ui/package.json ./packages/ui/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# Install ALL dependencies
RUN pnpm install --frozen-lockfile

ARG VITE_API_BASE_URL
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_MINIO_GAME_URL
ARG VITE_MINIO_THUMBNAIL_URL
ARG VITE_PUBLIC_SITE_URL
ARG VITE_WS_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_MINIO_GAME_URL=$VITE_MINIO_GAME_URL
ENV VITE_MINIO_THUMBNAIL_URL=$VITE_MINIO_THUMBNAIL_URL
ENV VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL
ENV VITE_WS_URL=$VITE_WS_URL

# Copy source code
COPY packages/lib ./packages/lib
COPY packages/ui ./packages/ui
COPY packages/typescript-config ./packages/typescript-config
COPY apps/admin ./apps/admin
COPY turbo.json ./turbo.json

# Build admin app
RUN pnpm --filter ./apps/admin run build

# ============================
# 2️⃣ RUNTIME STAGE (NO NGINX)
# ============================
FROM node:24-alpine AS runtime

WORKDIR /app

# Install lightweight static server
RUN npm install -g serve

# Copy build output
COPY --from=builder /app/apps/admin/dist ./dist

# Expose port
EXPOSE 8386

# Start static server
CMD ["serve", "-s", "dist", "-l", "8386"]
